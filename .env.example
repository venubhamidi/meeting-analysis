# Worker service (Railway) environment — SPEC.md §10.
# Placeholders only. Never commit real values; set them as Railway env vars.
# Phase 1 (record + local storage) uses none of these.

# Connect as the meetings_app role, not postgres. Its search_path is set at the
# role level to `meetings, extensions`, so migrations need no schema qualifiers.
#   postgresql://meetings_app:<password>@centerbeam.proxy.rlwy.net:18737/railway
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDINGS_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
SENTRY_DSN=

# v1 auth (SPEC.md §13.1): manually issued device token, replaced by Firebase
# phone OTP before any second user.
DEVICE_TOKEN=
DEVICE_USER_ID=

# Tests only: point the S3 client at MinIO instead of R2.
S3_ENDPOINT=
